# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://gym:gym@localhost:5432/gym

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Master key used to encrypt the AI API key stored in the database (32 bytes, base64)
APP_ENCRYPTION_KEY=

# Email (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gym <no-reply@localhost>"

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional fallback only: the AI key is normally set from the admin screen
ANTHROPIC_API_KEY=

# First administrator
ADMIN_EMAIL=
