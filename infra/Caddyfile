# Serves the PWA and catalog images, and proxies /api to the API on the same origin.
# TLS is terminated by Cloudflare; the tunnel reaches this server over plain HTTP inside the cluster.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
	}
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		# Everything comes from this origin; inline styles are needed by React style props and charts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy {$API_UPSTREAM:localhost:3000} {
			header_up X-Real-IP {client_ip}
		}
	}

	# The service worker and entry HTML must always be revalidated so updates are detected.
	@nocache path /sw.js /index.html /manifest.webmanifest /registerSW.js /catalog/manifest.json
	header @nocache Cache-Control "no-cache"

	# Hashed build assets and catalog images never change.
	@immutable path /assets/* /media/* /catalog/catalog-*.json
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
