# Copy to deploy/site.env (gitignored) with your real values, then `source deploy/site.env`.
K8S_HOST=k8s-master.example.com          # SSH host that runs kubectl
REGISTRY=registry.example.com            # container registry (e.g. a Forgejo instance)
REGISTRY_OWNER=owner                     # registry user/organization
DOMAIN=gym.example.com                   # public hostname (Cloudflare Tunnel)
MAIL_FROM="Gym <no-reply@example.com>"  # sender of account emails
VAPID_SUBJECT=mailto:admin@example.com  # contact for push services
